{
  "manifest_version": 3,
  "name": "Phishing URL warning",
  "version": "0.1.0",
  "description": "Asks a phishing scoring API about the site you open and shows a warning banner if it looks like phishing. Never blocks.",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Phishing URL warning"
  }
}
